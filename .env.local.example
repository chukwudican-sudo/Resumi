ANTHROPIC_API_KEY=your_key_here

# Offline testing: set RESUMI_MOCK=1 to stub /api/claude (no key, no cost).
# Tailoring becomes a deterministic fake transform. See app/lib/mockApi.ts.
# RESUMI_MOCK=1

# PDF export shells out to `tectonic`. It must be installed and on the server
# process's PATH. If the server can't find it (spawn ENOENT), set the absolute
# path here — e.g. `which tectonic` -> /home/you/.local/bin/tectonic
# TECTONIC_BIN=/absolute/path/to/tectonic
