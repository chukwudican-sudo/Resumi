ANTHROPIC_API_KEY=your_key_here

# PDF export shells out to `tectonic`. It must be installed and on the server
# process's PATH. If the server can't find it (spawn ENOENT), set the absolute
# path here — e.g. `which tectonic` -> /home/you/.local/bin/tectonic
# TECTONIC_BIN=/absolute/path/to/tectonic

# ── Database (Supabase) ────────────────────────────────────────────────────
# Project Settings -> Database -> Connection string -> Transaction pooler.
# Must be the pooler (port 6543), not the direct connection (5432): the direct
# one works locally and then exhausts connections under real traffic.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Auth (Clerk) ───────────────────────────────────────────────────────────
# Clerk dashboard -> API keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Clerk dashboard -> Webhooks -> your endpoint -> Signing secret.
# Required: the webhook is the only unauthenticated route, so signature
# verification is its entire security boundary. Without this set, the route
# refuses every request rather than trusting unverified ones.
# CLERK_WEBHOOK_SECRET=whsec_...

# Where Clerk sends people. Not secrets — routing config.
# Without the first two, a signed-out visitor to a protected page gets a 404
# instead of being sent to sign in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# After signing up someone has no profile yet, so they go to onboarding;
# returning users go straight to their applications.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/applications
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── Spend limits ───────────────────────────────────────────────────────────
# These have working defaults; set them only to change the numbers.
#
# The global ceiling is the backstop: total spend across every user in a
# rolling 24 hours. When it is reached, everyone is told the service is at
# capacity — deliberately, because at that point the refusal has nothing to do
# with whoever happened to ask next. Default $25.
# RESUMI_DAILY_USD_CEILING=25

# One account's share of that, so a single user cannot consume the whole
# ceiling and deny everyone else. Default $2.
# RESUMI_USER_DAILY_USD=2

# NOTE: this is the second line of defence, not the first. Set a monthly spend
# limit on the Anthropic API key itself at console.anthropic.com — that one
# holds even if this code is wrong, and it is the cheapest insurance available.

# ── PDF compile service (production only) ──────────────────────────────────
# Vercel's functions have no TeX installation, so a deployed app cannot run
# tectonic itself — see services/compile. Leave BOTH unset locally and the
# local binary is used instead, which is what makes development work without
# deploying anything.
#
# Set both or neither: half-configured is refused rather than silently falling
# back to a binary production does not have.
# COMPILE_SERVICE_URL=https://resumi-compile.fly.dev
# COMPILE_TOKEN=<the same value as `fly secrets set COMPILE_TOKEN`>
